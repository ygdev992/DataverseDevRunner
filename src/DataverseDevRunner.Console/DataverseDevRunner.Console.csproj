<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>DataverseDevRunner</AssemblyName>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\DataverseDevRunner.Core\DataverseDevRunner.Core.csproj" />
    <PackageReference Include="Microsoft.PowerPlatform.Dataverse.Client" Version="1.2.10" />
    <PackageReference Include="Spectre.Console" Version="0.49.1" />
    <Compile Include="..\..\local\Scenarios\**\*.cs" Link="LocalScenarios\%(RecursiveDir)%(Filename)%(Extension)" />
    <Content Include="..\..\configuration\test-guides.json" Link="configuration\test-guides.json"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Import Project="..\..\local\References.props" Condition="Exists('..\..\local\References.props')" />
</Project>
